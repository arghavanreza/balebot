# Copy to .dev.vars for local `pywrangler dev`.
# Wrangler does not read .env. Do not commit real values.
# Production: `uv run pywrangler secret put <NAME>`

BALE_TOKEN=
ADMIN_ID=
WEBHOOK_SECRET=

# Local only. Not a secret. 1 = skip Bale and echo actions in the webhook response.
DRY_RUN=

# Optional payer account for paya .ccti files. Leave empty to use the editable
# defaults in the bot (a valid Bank Mehr sheba, bank code 060). Any Mehr branch is fine.
# DEBTOR_NAME=
# DEBTOR_IBAN=
# DEBTOR_BIC=
